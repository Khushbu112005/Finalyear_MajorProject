# ============================================================
# CivicSphere AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all CHANGE_ME values.
# The application will refuse to start with placeholder secrets
# in non-development environments.
# ============================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=CivicSphere-AI
API_PREFIX=/api/v1

# --- Security & CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_key_at_least_32_bytes
JWT_ALGORITHM=HS256
MAX_SOURCE_SIZE_BYTES=5242880

# --- CSRF ---
CSRF_SECRET_KEY=CHANGE_ME_generate_a_separate_csrf_secret

# --- Ingestion Security / SSRF Protections ---
SSRF_PROTECTION_ENABLED=true
ALLOWED_INGESTION_SCHEMES=["http","https"]
FETCH_TIMEOUT_SECONDS=10.0
MAX_REDIRECTS=3

# --- PostgreSQL (Primary Relational DB) ---
DATABASE_URL=postgresql+asyncpg://civicsphere:CHANGE_ME@localhost:5432/civicsphere
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Neo4j (Graph DB) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_set_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_DEPTH=3
NEO4J_DEFAULT_DEPTH=2
NEO4J_MAX_NEIGHBORS=10

# --- Redis (Cache / Background Jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (Document Files) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
# For S3-compatible:
# STORAGE_BACKEND=s3
# S3_BUCKET=civicsphere-documents
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME

# --- AI Provider Configurations ---
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
LLM_PROVIDER=mock
LLM_MODEL=claude-3-5-sonnet-20241022
RERANKER_PROVIDER=heuristic

# For production (uncomment and configure one):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=CHANGE_ME
# LLM_PROVIDER=google
# GOOGLE_API_KEY=CHANGE_ME

# --- Retrieval Parameters ---
DEFAULT_TOP_K=5
MAX_TOP_K=25
RRF_K=60
EVIDENCE_CONFIDENCE_THRESHOLD_STRONG=0.90
EVIDENCE_CONFIDENCE_THRESHOLD_GOOD=0.75
EVIDENCE_CONFIDENCE_THRESHOLD_LIMITED=0.50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
